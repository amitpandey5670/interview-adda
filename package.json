{
  "name": "interview-adda",
  "private": true,
  "version": "0.1.0",
  "description": "Interview preparation static site and JSON documentation",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-with-base.mjs local serve",
    "build": "node scripts/ng-with-base.mjs local build",
    "build:pages": "node scripts/ng-with-base.mjs githubPages build && node scripts/finalize-pages.mjs",
    "watch": "node scripts/ng-with-base.mjs local build -- --watch --configuration development",
    "test:content": "vitest run --config vitest.content.config.ts",
    "test:app": "ng test",
    "test": "npm run test:content && npm run test:app",
    "typecheck": "tsc --noEmit -p data/contracts/tsconfig.json && ng build --configuration development --base-href /",
    "lint": "eslint ."
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.17.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.18.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.35.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.0.8"
  }
}
