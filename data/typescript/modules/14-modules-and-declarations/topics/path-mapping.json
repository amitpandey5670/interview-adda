{
  "id": "typescript-14-path-mapping",
  "slug": "path-mapping",
  "title": "paths, baseUrl, and import aliases",
  "moduleId": "typescript-14-modules-and-declarations",
  "order": 2,
  "hook": "`paths` and `baseUrl` create import aliases like `@app/*` — compile-time only unless bundler or tsc-alias rewrites emit. Node still sees alias strings at runtime.",
  "sections": [
    {
      "heading": "What is this?",
      "blocks": [
        {
          "type": "prose",
          "text": "**paths** maps patterns to folders. TypeScript resolves for checking; **emit keeps alias** unless bundler rewrites. **package.json imports** (#paths) is Node 20+ native alternative. Monorepos prefer **package names** + project references over deep paths."
        },
        {
          "type": "glossary",
          "title": "Key terms",
          "entries": [
            {
              "term": "paths",
              "longForm": "tsconfig paths",
              "plainDefinition": "Compile-time alias — no emit rewrite.",
              "example": "\"@/*\": [\"src/*\"]"
            },
            {
              "term": "baseUrl",
              "longForm": "resolution root",
              "plainDefinition": "Base for non-relative imports.",
              "example": "\"baseUrl\": \"./src\""
            },
            {
              "term": "tsc-alias",
              "longForm": "post emit rewrite",
              "plainDefinition": "Rewrites paths in JS for Node.",
              "example": "tsc && tsc-alias"
            },
            {
              "term": "imports field",
              "longForm": "package.json imports",
              "plainDefinition": "Runtime-native # alias.",
              "example": "\"#internal/*\": \"./src/*\""
            }
          ]
        }
      ]
    },
    {
      "heading": "Why does it matter?",
      "blocks": [
        {
          "type": "prose",
          "text": "CI MODULE_NOT_FOUND when paths work in IDE. Vite alias must mirror tsconfig paths."
        },
        {
          "type": "callout",
          "variant": "tip",
          "title": "Interview trap: paths rewrite emit",
          "body": "tsc never rewrites path aliases — bundler or tsc-alias required."
        }
      ]
    },
    {
      "heading": "How it works step by step",
      "blocks": [
        {
          "type": "steps",
          "title": "Mental model",
          "items": [
            {
              "title": "Define paths",
              "body": "@app/* → src/*"
            },
            {
              "title": "Mirror in Vite",
              "body": "resolve.alias"
            },
            {
              "title": "Or package imports",
              "body": "Node # paths"
            },
            {
              "title": "Monorepo packages",
              "body": "@org/pkg name imports"
            }
          ]
        },
        {
          "type": "diagram",
          "diagram": {
            "type": "mermaid",
            "title": "paths compile vs runtime",
            "source": "flowchart LR\n  SRC[\"@app/x\"] --> TSC[typecheck]\n  TSC --> EMIT[\"emit @app/x\"]\n  EMIT --> BUN[bundler rewrite] or FAIL[Node fail]"
          }
        }
      ]
    },
    {
      "heading": "Code walkthrough",
      "blocks": [
        {
          "type": "snippet",
          "snippet": {
            "language": "json",
            "label": "tsconfig paths",
            "code": "{\n  \"compilerOptions\": {\n    \"baseUrl\": \".\",\n    \"paths\": { \"@app/*\": [\"src/app/*\"] }\n  }\n}",
            "explanation": "Alias for imports."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Alias import",
            "code": "import { Button } from \"@app/components/Button\";",
            "explanation": "Emit unchanged."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Vite alias",
            "code": "export default { resolve: { alias: { \"@app\": resolve(__dirname, \"src/app\") } } };",
            "explanation": "Must match tsconfig."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Failure: Node without rewrite",
            "code": "// emit: require(\"@app/foo\") → MODULE_NOT_FOUND",
            "explanation": "paths alone insufficient for Node."
          }
        }
      ]
    },
    {
      "heading": "Compare with JavaScript and C#",
      "blocks": [
        {
          "type": "comparisonTable",
          "title": "paths, baseUrl, and import aliases across languages",
          "headers": [
            "Aspect",
            "TypeScript",
            "JavaScript",
            "C#"
          ],
          "rows": [
            [
              "Mechanism",
