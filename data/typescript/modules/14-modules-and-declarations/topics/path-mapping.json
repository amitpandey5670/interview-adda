              "Native Node 20+",
              "Compile+runtime"
            ]
          ]
        }
      ]
    },
    {
      "heading": "Common mistakes",
      "blocks": [
        {
          "type": "callout",
          "variant": "warning",
          "title": "Pitfalls to avoid",
          "body": "paths work in Node without bundler. Mismatched Vite/tsconfig. paths instead of package name in monorepo."
        }
      ]
    },
    {
      "heading": "Senior interview depth",
      "blocks": [
        {
          "type": "prose",
          "text": "Nx generates consistent paths. ESLint import resolver reads paths. Prefer @org/lib package imports."
        },
        {
          "type": "comparisonTable",
          "title": "Tradeoffs at senior level",
          "headers": [
            "Approach",
            "When it wins",
            "When it fails"
          ],
          "rows": [
            [
