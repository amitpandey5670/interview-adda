              "package imports",
              "Runtime native",
              "Node version"
            ],
            [
              "relative only",
              "Simple",
              "Deep fragile paths"
            ]
          ]
        },
        {
          "type": "callout",
          "variant": "warning",
          "title": "What gets you rejected in interviews",
          "body": "Says paths rewrites emit. No monorepo package strategy."
        }
      ]
    }
  ],
  "interviewTakeaways": [
