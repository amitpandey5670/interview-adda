    },
    {
      "heading": "Common mistakes",
      "blocks": [
        {
          "type": "callout",
          "variant": "warning",
          "title": "Pitfalls to avoid",
          "body": "any for untyped imports. stale @types. loose declare module."
        }
      ]
    },
    {
      "heading": "Senior interview depth",
      "blocks": [
        {
          "type": "prose",
          "text": "attw (Are The Types Wrong) for publish validation. api-extractor for rollup .d.ts."
        },
        {
          "type": "comparisonTable",
          "title": "Tradeoffs at senior level",
          "headers": [
            "Approach",
            "When it wins",
            "When it fails"
          ],
          "rows": [
            [
              "bundled types",
              "single version",
              "author maintains"
            ],
            [
              "@types",
              "fast",
              "skew risk"
            ],
            [
              "shim",
              "quick",
              "no runtime validation"
            ]
          ]
        },
        {
          "type": "callout",
          "variant": "warning",
          "title": "What gets you rejected in interviews",
          "body": "@types when package bundles types. Cannot write declare module."
        }
      ]
    }
  ],
  "interviewTakeaways": [
    "Check bundled types first.",
    "declare module shim.",
    "allowJs+JSDoc migration.",
    "60s: .d.ts describes JS. @types DT. publish types in npm. attw tool.",
    "Follow-up: attw."
  ],
  "commonPitfalls": [
    "Weak: import as any.",
    "Weak: @types mismatch.",
    "Strong: \"bundled first. shim. JSDoc migrate. attw publish.\""
