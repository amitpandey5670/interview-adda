        }
      ]
    },
    {
      "heading": "Code walkthrough",
      "blocks": [
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "declare global",
            "code": "export {};\ndeclare global { interface Window { dataLayer: Array<Record<string, unknown>>; } }\nwindow.dataLayer.push({ event: \"pv\" });",
            "explanation": "export {} makes module."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "CSS module",
            "code": "declare module \"*.module.css\" {\n  const classes: { readonly [key: string]: string };\n  export default classes;\n}",
            "explanation": "Wildcard asset module."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "ProcessEnv",
            "code": "declare namespace NodeJS {\n  interface ProcessEnv { DATABASE_URL: string; NODE_ENV: \"development\" | \"production\" | \"test\"; }\n}",
            "explanation": "Strict env typing."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Failure: global without export",
            "code": "// declare global in script mode may fail — use export {} or .d.ts",
            "explanation": "Module context required."
          }
        }
