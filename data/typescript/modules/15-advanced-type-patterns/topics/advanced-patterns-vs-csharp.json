            "label": "TS brand",
            "code": "type UserId = string & { __b: \"UserId\" };\nfunction UserId(s: string): UserId { if (!s) throw new Error(); return s as UserId; }",
            "explanation": "Compile tag only."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "csharp",
            "label": "C# record",
            "code": "public readonly record struct UserId(string Value) {\n  public static UserId Create(string s) => string.IsNullOrEmpty(s) ? throw new ArgumentException() : new UserId(s);\n}",
            "explanation": "Runtime nominal."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "DeepPartial type-only",
