          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Zod over conditional",
            "code": "const UserSchema = z.object({ id: z.string().uuid(), email: z.string().email() });\ntype User = z.infer<typeof UserSchema>;\nfunction parseUser(raw: unknown) { return UserSchema.parse(raw); }",
            "explanation": "Single source runtime+type."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Named aliases",
            "code": "// Split RouteHead, RouteTail instead of 40-line template recursive type",
            "explanation": "Decompose for compiler and humans."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "bash",
            "label": "Profile tsc",
