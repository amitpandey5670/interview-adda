{
  "id": "typescript-16-stage-3-decorators",
  "slug": "stage-3-decorators",
  "title": "Stage 3 decorators and decorator factories",
  "moduleId": "typescript-16-decorators-and-metadata",
  "order": 1,
  "hook": "**Stage 3 decorators** (TS 5.0+, TC39) use `(value, context) => value` — replaces experimental 3-arg API. context.kind, context.name, addInitializer for setup.",
  "sections": [
    {
      "heading": "What is this?",
      "blocks": [
        {
          "type": "prose",
          "text": "Disable experimentalDecorators. Decorator receives value + **DecoratorContext**. Class/method/field/accessor targets. **Decorator factories** return decorator. **addInitializer** runs post-construct. No reflect-metadata required for basic metadata — context provides it."
        },
        {
          "type": "glossary",
          "title": "Key terms",
          "entries": [
            {
              "term": "Stage 3",
              "longForm": "standard decorators",
              "plainDefinition": "TC39 proposal in TS 5.0.",
              "example": "(fn, context) => fn"
            },
            {
              "term": "DecoratorContext",
              "longForm": "context object",
              "plainDefinition": "kind, name, static, private.",
              "example": "context.kind === \"method\""
            },
            {
              "term": "factory",
              "longForm": "decorator factory",
              "plainDefinition": "Returns decorator with config.",
              "example": "Logged(\"api\")"
            },
            {
              "term": "addInitializer",
              "longForm": "post-construct",
              "plainDefinition": "Callback after instance created.",
              "example": "context.addInitializer(()=>{})"
            }
          ]
        }
      ]
    },
    {
      "heading": "Why does it matter?",
      "blocks": [
        {
          "type": "prose",
          "text": "Angular 19+ path to standard decorators. Migration from legacy. Interview: signature difference."
        },
        {
          "type": "callout",
          "variant": "tip",
          "title": "Interview trap: legacy vs stage 3",
          "body": "Legacy (target, key, descriptor) vs stage 3 (value, context) — different APIs."
        }
      ]
    },
    {
      "heading": "How it works step by step",
      "blocks": [
        {
          "type": "steps",
          "title": "Mental model",
          "items": [
            {
              "title": "TS 5+ config",
              "body": "experimentalDecorators false"
            },
            {
              "title": "write decorator",
              "body": "(value, context)"
            },
            {
              "title": "factory for opts",
              "body": "return decorator"
            },
            {
              "title": "test emit",
              "body": "stage 3 in output"
            }
          ]
        },
        {
          "type": "diagram",
          "diagram": {
            "type": "mermaid",
            "title": "Stage 3 apply",
            "source": "flowchart TD\n  CLASS --> DEC[@decorator]\n  DEC --> CTX[context]\n  CTX --> OUT[value/initializer]"
          }
        }
      ]
    },
    {
      "heading": "Code walkthrough",
      "blocks": [
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Method decorator",
            "code": "function logged<T extends (...args: unknown[]) => unknown>(fn: T, ctx: ClassMethodDecoratorContext): T {\n  const name = String(ctx.name);\n  return function (this: unknown, ...args: unknown[]) { console.log(name); return fn.apply(this, args); } as T;\n}\nclass Api { @logged fetch() { return \"d\"; } }",
            "explanation": "Stage 3 method wrap."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Factory + addInitializer",
            "code": "function Validate(min: number) {\n  return function (_v: unknown, ctx: ClassFieldDecoratorContext) {\n    ctx.addInitializer(function () {\n      const v = (this as Record<string, unknown>)[ctx.name as string];\n      if (typeof v === \"number\" && v < min) throw new Error(\"small\");\n    });\n  };\n}\nclass C { @Validate(0) accessor timeout = 100; }",
            "explanation": "Field validation via initializer."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Class decorator",
            "code": "function sealed<T extends { new(...a: unknown[]): object }>(ctor: T, ctx: ClassDecoratorContext) {\n  ctx.addInitializer(() => console.log(ctx.name));\n  return ctor;\n}\n@sealed class S {}",
            "explanation": "Class decorator."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Failure: mixed modes",
            "code": "// experimentalDecorators true + stage 3 body = errors",
            "explanation": "One decorator system per project."
          }
        }
      ]
    },
