{
  "id": "typescript-16-decorators-in-frameworks",
  "slug": "decorators-in-frameworks",
  "title": "Decorators in Angular, NestJS, and class-validator",
  "moduleId": "typescript-16-decorators-and-metadata",
  "order": 4,
  "hook": "**Angular**, **NestJS**, **class-validator** use legacy decorators — @Component, @Injectable, @IsEmail. Runtime validation + DI metadata.",
  "sections": [
    {
      "heading": "What is this?",
      "blocks": [
        {
          "type": "prose",
          "text": "@Component → Ivy metadata. Nest @Module/@Controller/@Get wires routes + DI. class-validator decorators register rules read at runtime by ValidationPipe. Need experimentalDecorators + often emitDecoratorMetadata."
        },
        {
          "type": "glossary",
          "title": "Key terms",
          "entries": [
            {
              "term": "@Component",
              "longForm": "Angular",
              "plainDefinition": "template, selector, styles.",
              "example": "@Component({ selector: \"app\" })"
            },
            {
              "term": "@Injectable",
              "longForm": "DI marker",
              "plainDefinition": "Nest/Angular container.",
              "example": "@Injectable()"
            },
            {
              "term": "class-validator",
              "longForm": "validation dec",
              "plainDefinition": "@IsString on DTO fields.",
              "example": "@IsEmail()"
            },
            {
              "term": "ValidationPipe",
              "longForm": "Nest pipe",
              "plainDefinition": "Runs class-validator on body.",
              "example": "useGlobalPipes"
            }
          ]
        }
      ]
    },
    {
      "heading": "Why does it matter?",
      "blocks": [
        {
          "type": "prose",
          "text": "Full-stack Angular+Nest interviews. DTO without decorators = no runtime validation. tsconfig wrong = broken DI."
        },
        {
          "type": "callout",
          "variant": "tip",
          "title": "Interview trap: decorators validate types",
          "body": "class-validator runtime — TS types do not validate HTTP body."
        }
      ]
    },
    {
      "heading": "How it works step by step",
      "blocks": [
        {
          "type": "steps",
          "title": "Mental model",
          "items": [
            {
              "title": "tsconfig legacy",
              "body": "experimentalDecorators"
            },
            {
              "title": "reflect-metadata",
              "body": "Nest entry"
            },
            {
              "title": "DTO decorators",
              "body": "class-validator"
            },
            {
              "title": "ValidationPipe",
              "body": "global"
            }
          ]
        },
        {
          "type": "diagram",
          "diagram": {
            "type": "mermaid",
            "title": "Nest request",
            "source": "flowchart TD\n  POST --> VP[ValidationPipe]\n  VP --> CV[class-validator]\n  CV --> CTRL[@Controller]"
          }
        }
      ]
    },
    {
      "heading": "Code walkthrough",
      "blocks": [
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Nest DTO",
            "code": "import { IsEmail, IsString, MinLength } from \"class-validator\";\nexport class CreateUserDto {\n  @IsString() @MinLength(2) name!: string;\n  @IsEmail() email!: string;\n}\n@Post() create(@Body() dto: CreateUserDto) { return this.users.create(dto); }",
            "explanation": "Runtime validation on DTO."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Angular component",
            "code": "@Component({ selector: \"user-card\", standalone: true, template: `<p>{{user.name}}</p>` })\nexport class UserCard { @Input({ required: true }) user!: User; }",
            "explanation": "Legacy component+Input."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Nest controller",
            "code": "@Injectable() export class UsersService { findAll() { return []; } }\n@Controller(\"users\") export class UsersController {\n  constructor(private users: UsersService) {}\n  @Get() list() { return this.users.findAll(); }\n}",
            "explanation": "DI wiring."
          }
        },
        {
          "type": "snippet",
          "snippet": {
            "language": "typescript",
            "label": "Failure: DTO no decorators",
            "code": "export class CreateUserDto { name!: string; }\n// ValidationPipe does nothing without decorators",
            "explanation": "Types ≠ runtime validation."
          }
        }
      ]
    },
