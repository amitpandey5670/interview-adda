{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/topic.schema.json",
  "title": "Topic page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "moduleId",
    "order",
    "hook",
    "sections",
    "interviewTakeaways",
    "commonPitfalls",
    "relatedTopicIds",
    "jsTsCorrelations",
    "officialSources"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "moduleId": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1 },
    "hook": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "definitions.json#/$defs/contentSection" }
    },
    "interviewTakeaways": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commonPitfalls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "introducedIn": { "type": "string", "minLength": 1 },
    "relatedTopicIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "jsTsCorrelations": {
      "type": "array",
      "items": { "$ref": "definitions.json#/$defs/jsTsCorrelation" }
    },
    "officialSources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "definitions.json#/$defs/officialSource" }
    },
    "animationHint": {
      "type": "string",
      "enum": ["compare", "flow", "stack-heap", "timeline", "network-flow", "region-map", "request-path"]
    },
    "scenarioTag": {
      "type": "string",
      "enum": [
        "sqs-consumer",
        "redis-cache",
        "rabbitmq",
        "skiasharp-dispose",
        "auth-token",
        "csv-import",
        "high-concurrency",
        "lambda-vpc",
        "step-functions-saga",
        "cloudfront-origin",
        "vpc-troubleshoot",
        "saas-tenant-routing",
        "datasync-migration"
      ]
    }
  }
}
