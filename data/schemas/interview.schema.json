{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/interview.schema.json",
  "title": "Module interview page",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "title", "items"],
  "properties": {
    "moduleId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer", "followUps", "sixtySeconds"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "followUps": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sixtySeconds": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
