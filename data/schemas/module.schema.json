{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/module.schema.json",
  "title": "Module document",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "title", "order", "stage", "summary", "officialHubs", "topics"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1 },
    "stage": { "$ref": "definitions.json#/$defs/stage" },
    "summary": { "type": "string", "minLength": 1 },
    "officialHubs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "definitions.json#/$defs/officialSource" }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "title", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
