{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/definitions.json",
  "title": "Shared content definitions",
  "$defs": {
    "officialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "codeSnippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "label", "code", "explanation"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "longForm", "plainDefinition"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "shortForm": { "type": "string", "minLength": 1 },
        "longForm": { "type": "string", "minLength": 1 },
        "plainDefinition": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 }
      }
    },
    "mermaidDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "source"],
      "properties": {
        "type": { "type": "string", "const": "mermaid" },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 }
      }
    },
    "stepItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "snippet": { "$ref": "#/$defs/codeSnippet" }
      }
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "type": "string", "const": "prose" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "snippet"],
          "properties": {
            "type": { "type": "string", "const": "snippet" },
            "snippet": { "$ref": "#/$defs/codeSnippet" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entries"],
          "properties": {
            "type": { "type": "string", "const": "glossary" },
            "title": { "type": "string", "minLength": 1 },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/glossaryEntry" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "diagram"],
          "properties": {
            "type": { "type": "string", "const": "diagram" },
            "diagram": { "$ref": "#/$defs/mermaidDiagram" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "items"],
          "properties": {
            "type": { "type": "string", "const": "steps" },
            "title": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/stepItem" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "variant", "title", "body"],
          "properties": {
            "type": { "type": "string", "const": "callout" },
            "variant": { "type": "string", "enum": ["tip", "remember", "warning"] },
            "title": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "headers", "rows"],
          "properties": {
            "type": { "type": "string", "const": "comparisonTable" },
            "title": { "type": "string", "minLength": 1 },
            "headers": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "contentSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "prose": { "type": "string", "minLength": 1 },
        "snippets": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeSnippet" }
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contentBlock" }
        }
      },
      "anyOf": [{ "required": ["prose"] }, { "required": ["blocks"] }]
    },
    "stage": {
      "type": "string",
      "enum": ["foundation", "intermediate", "advanced"]
    },
    "jsTsCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "concept", "note", "futureTopicSlug"],
      "properties": {
        "language": { "type": "string", "enum": ["javascript", "typescript"] },
        "concept": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "futureTopicSlug": { "type": "string", "minLength": 1 }
      }
    },
    "conceptCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 },
        "topicSlug": { "type": "string", "minLength": 1 }
      }
    }
  }
}
