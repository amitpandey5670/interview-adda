{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/definitions.json",
  "title": "Shared content definitions",
  "$defs": {
    "officialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "codeSnippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "label", "code", "explanation"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "contentSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "prose"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "prose": { "type": "string", "minLength": 1 },
        "snippets": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeSnippet" }
        }
      }
    },
    "stage": {
      "type": "string",
      "enum": ["foundation", "intermediate", "advanced"]
    },
    "jsTsCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "concept", "note", "futureTopicSlug"],
      "properties": {
        "language": { "type": "string", "enum": ["javascript", "typescript"] },
        "concept": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "futureTopicSlug": { "type": "string", "minLength": 1 }
      }
    }
  }
}
