{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/quick-overview.schema.json",
  "title": "Module quick overview",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "title", "rememberThis", "bullets", "rows"],
  "properties": {
    "moduleId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "rememberThis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "bullets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
