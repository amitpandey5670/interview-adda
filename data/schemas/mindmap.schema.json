{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/mindmap.schema.json",
  "title": "Module mind map",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "title"],
  "properties": {
    "moduleId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "intro": { "type": "string", "minLength": 1 },
    "overviewDiagram": { "$ref": "definitions.json#/$defs/mermaidDiagram" },
    "revisionDiagram": { "$ref": "definitions.json#/$defs/mermaidDiagram" },
    "conceptCards": {
      "type": "array",
      "items": { "$ref": "definitions.json#/$defs/conceptCard" }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "parentId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": ["overviewDiagram", "conceptCards"],
      "properties": {
        "conceptCards": { "minItems": 4 }
      }
    },
    {
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "minItems": 1 }
      }
    }
  ]
}
