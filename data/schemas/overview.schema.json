{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-adda.local/schemas/overview.schema.json",
  "title": "Language overview page",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "language", "title", "hook", "sections", "stages", "timeMaps", "officialSources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "hook": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "definitions.json#/$defs/contentSection" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "moduleIds"],
        "properties": {
          "id": { "$ref": "definitions.json#/$defs/stage" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "moduleIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "timeMaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["duration", "focus", "moduleIds"],
        "properties": {
          "duration": { "type": "string", "minLength": 1 },
          "focus": { "type": "string", "minLength": 1 },
          "moduleIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "officialSources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "definitions.json#/$defs/officialSource" }
    }
  }
}
